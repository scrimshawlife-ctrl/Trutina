{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/trutina/brier.batch.report.v0.schema.json",
  "title": "brier.batch.report.v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "specialist",
    "display",
    "mode",
    "status",
    "honesty",
    "formula",
    "score_scale",
    "manifest_hash",
    "corpus_ref",
    "snapshot_ref",
    "snapshot_as_of",
    "settlement_cutoff",
    "n_total",
    "n_scored",
    "n_void",
    "n_unsettled",
    "n_zero_weight",
    "weight_sum",
    "sum_weighted_loss",
    "brier",
    "event_count",
    "nonevent_count",
    "prevalence",
    "weight_ess",
    "coverage",
    "reasons",
    "forecast_eligible",
    "can_promote",
    "weight_mutation",
    "phenomenal",
    "ledger_id"
  ],
  "properties": {
    "schema": {"const": "brier.batch.report.v0"},
    "specialist": {"const": "abx.brier"},
    "display": {"const": "Trutina"},
    "mode": {"const": "BATCH"},
    "status": {"enum": ["COMPUTABLE", "NOT_COMPUTABLE"]},
    "honesty": {"enum": ["OBSERVED", "INFERRED", "NOT_COMPUTABLE"]},
    "formula": {"const": "BRIER_BINARY_V1"},
    "score_scale": {"const": "binary_0_1"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corpus_ref": {"type": "string", "minLength": 1},
    "snapshot_ref": {"type": "string", "minLength": 1},
    "snapshot_as_of": {"type": "string", "format": "date-time"},
    "settlement_cutoff": {"type": "string", "format": "date-time"},
    "n_total": {"type": "integer", "minimum": 0},
    "n_scored": {"type": "integer", "minimum": 0},
    "n_void": {"type": "integer", "minimum": 0},
    "n_unsettled": {"type": "integer", "minimum": 0},
    "n_zero_weight": {"type": "integer", "minimum": 0},
    "weight_sum": {"type": ["number", "null"], "minimum": 0},
    "sum_weighted_loss": {"type": ["number", "null"], "minimum": 0},
    "brier": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "event_count": {"type": "integer", "minimum": 0},
    "nonevent_count": {"type": "integer", "minimum": 0},
    "prevalence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "weight_ess": {"type": ["number", "null"], "minimum": 0},
    "coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "baseline": {"type": "null"},
    "decomposition": {"type": "null"},
    "interval": {"type": "null"},
    "reasons": {
      "type": "array",
      "items": {
        "enum": [
          "EMPTY_COHORT",
          "ZERO_WEIGHT",
          "INVALID_MEMBER",
          "DUPLICATE_CASE",
          "MIXED_ESTIMAND",
          "SETTLEMENT_AFTER_CUTOFF",
          "SETTLEMENT_TIME_REQUIRED",
          "SETTLEMENT_BEFORE_ISSUE",
          "CUTOFF_SNAPSHOT_REQUIRED",
          "ZERO_REFERENCE_LOSS",
          "SMALL_REFERENCE_LOSS",
          "NONFINITE_RESULT"
        ]
      },
      "uniqueItems": true
    },
    "forecast_eligible": {"const": false},
    "can_promote": {"const": false},
    "weight_mutation": {"const": false},
    "phenomenal": {"const": false},
    "ledger_id": {"type": "null"}
  }
}
