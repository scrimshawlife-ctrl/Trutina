{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/trutina/brier.batch.report.v0.schema.json",
  "title": "brier.batch.report.v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "specialist",
    "display",
    "mode",
    "status",
    "honesty",
    "formula",
    "score_scale",
    "manifest_hash",
    "corpus_ref",
    "snapshot_ref",
    "snapshot_as_of",
    "settlement_cutoff",
    "n_total",
    "n_scored",
    "n_void",
    "n_unsettled",
    "n_zero_weight",
    "weight_sum",
    "sum_weighted_loss",
    "brier",
    "event_count",
    "nonevent_count",
    "prevalence",
    "weight_ess",
    "coverage",
    "reasons",
    "forecast_eligible",
    "can_promote",
    "weight_mutation",
    "phenomenal",
    "ledger_id"
  ],
  "properties": {
    "schema": {"const": "brier.batch.report.v0"},
    "specialist": {"const": "abx.brier"},
    "display": {"const": "Trutina"},
    "mode": {"const": "BATCH"},
    "status": {"enum": ["COMPUTABLE", "NOT_COMPUTABLE"]},
    "honesty": {"enum": ["OBSERVED", "INFERRED", "NOT_COMPUTABLE"]},
    "formula": {"const": "BRIER_BINARY_V1"},
    "score_scale": {"const": "binary_0_1"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corpus_ref": {"type": "string", "minLength": 1},
    "snapshot_ref": {"type": "string", "minLength": 1},
    "snapshot_as_of": {"type": "string", "format": "date-time"},
    "settlement_cutoff": {"type": "string", "format": "date-time"},
    "n_total": {"type": "integer", "minimum": 0},
    "n_scored": {"type": "integer", "minimum": 0},
    "n_void": {"type": "integer", "minimum": 0},
    "n_unsettled": {"type": "integer", "minimum": 0},
    "n_zero_weight": {"type": "integer", "minimum": 0},
    "weight_sum": {"type": ["number", "null"], "minimum": 0},
    "sum_weighted_loss": {"type": ["number", "null"], "minimum": 0},
    "brier": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "event_count": {"type": "integer", "minimum": 0},
    "nonevent_count": {"type": "integer", "minimum": 0},
    "prevalence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "weight_ess": {"type": ["number", "null"], "minimum": 0},
    "coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "baseline": {"type": "null"},
    "decomposition": {"type": "null"},
    "interval": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema", "specialist", "display", "estimand", "method", "confidence_level",
            "seed", "rng_version", "replicates_requested", "replicates_valid",
            "resampling_unit", "block_length", "lower", "upper", "status", "reason",
            "zero_reference_replicates"
          ],
          "properties": {
            "schema": {"const": "brier.interval.report.v0"},
            "specialist": {"const": "abx.brier"},
            "display": {"const": "Trutina"},
            "estimand": {"enum": ["BRIER_MEAN", "PAIRED_DELTA", "BSS"]},
            "method": {"enum": ["IID_PERCENTILE_BOOTSTRAP_V1", "CLUSTER_PERCENTILE_BOOTSTRAP_V1", "MOVING_BLOCK_PERCENTILE_BOOTSTRAP_V1"]},
            "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
            "seed": {"type": "integer", "minimum": 0},
            "rng_version": {"type": "string", "minLength": 1},
            "replicates_requested": {"type": "integer", "minimum": 1},
            "replicates_valid": {"type": "integer", "minimum": 0},
            "resampling_unit": {"enum": ["CASE", "CLUSTER", "MOVING_BLOCK"]},
            "block_length": {"type": ["integer", "null"], "minimum": 1},
            "lower": {"type": ["number", "null"]},
            "upper": {"type": ["number", "null"]},
            "status": {"enum": ["COMPUTABLE", "NOT_COMPUTABLE"]},
            "reason": {"enum": [null, "SAMPLING_DESIGN_UNKNOWN", "DEGENERATE_SAMPLE", "ZERO_REFERENCE_REPLICATE", "INVALID_DESIGN", "RESOURCE_LIMIT", "NONFINITE_RESULT"]},
            "zero_reference_replicates": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "enum": [
          "EMPTY_COHORT",
          "ZERO_WEIGHT",
          "INVALID_MEMBER",
          "DUPLICATE_CASE",
          "MIXED_ESTIMAND",
          "SETTLEMENT_AFTER_CUTOFF",
          "SETTLEMENT_TIME_REQUIRED",
          "SETTLEMENT_BEFORE_ISSUE",
          "CUTOFF_SNAPSHOT_REQUIRED",
          "ZERO_REFERENCE_LOSS",
          "SMALL_REFERENCE_LOSS",
          "NONFINITE_RESULT"
        ]
      },
      "uniqueItems": true
    },
    "forecast_eligible": {"const": false},
    "can_promote": {"const": false},
    "weight_mutation": {"const": false},
    "phenomenal": {"const": false},
    "ledger_id": {"type": "null"}
  }
}
